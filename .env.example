# Doubletake server configuration. Copy to .env (never committed).
# Every value here has a documented default; only the brain credentials are required for M1.

# --- paths ---------------------------------------------------------------
DOUBLETAKE_DATA_DIR=~/.doubletake          # SQLite DB, media blobs, logs, keyfile
DOUBLETAKE_NOTES_DIR=~/Doubletake          # the ONLY folder the brain may write to; Markdown exports land here
DOUBLETAKE_READ_ROOTS=~                    # colon-separated roots the brain may read
DOUBLETAKE_READ_DENY=~/.ssh:~/.aws:~/.config:~/.gnupg:~/Library/Keychains:~/.doubletake:**/.env*:**/*.pem:**/*.key:**/node_modules

# --- network -------------------------------------------------------------
DOUBLETAKE_BIND=127.0.0.1                  # expose via `tailscale serve`, never bind 0.0.0.0
DOUBLETAKE_PORT=7391
DOUBLETAKE_PUBLIC_URL=                     # https://<machine>.<tailnet>.ts.net — used in QR pairing + push payloads
DOUBLETAKE_WEBHOOK_PUBLIC_HOST=            # hostname of the Cloudflare Tunnel / Funnel that reaches /webhooks/instagram only
DOUBLETAKE_WEB_DIST=                       # built PWA to serve at /; default = apps/web/dist when it exists
DOUBLETAKE_LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent

# --- brain (pick one default; adapters are configured in the UI/settings too) -------------
DOUBLETAKE_BRAIN=claude-agent-sdk          # claude-agent-sdk | headless-cli | openai-compatible
DOUBLETAKE_BRAIN_MODEL=                    # model id passed to the adapter; empty = the adapter/CLI default.
                                           # If you route through a proxy (9Router, rewter, ...) make sure the
                                           # default model actually returns text: free/misrouted combos often
                                           # return EMPTY results, which Doubletake reports as a failed run.
ANTHROPIC_API_KEY=                         # for claude-agent-sdk (or rely on `claude` login)
ANTHROPIC_BASE_URL=                        # optional proxy for the Claude SDK (inherited by the SDK subprocess)
OPENAI_BASE_URL=                           # for openai-compatible (OpenAI, DeepSeek, Ollama, LM Studio, rewter, ...)
OPENAI_API_KEY=
OPENAI_MODEL=

# --- web search for the openai-compatible tool loop -----------------------
SEARCH_PROVIDER=searxng                    # searxng | brave | tavily
SEARXNG_URL=http://127.0.0.1:8888
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# --- media ---------------------------------------------------------------
DOUBLETAKE_VISION=cloud                    # cloud (via brain) | local (Qwen2.5-VL / Moondream, opt-in)
DOUBLETAKE_WHISPER_BACKEND=auto            # auto | mlx | whisper.cpp | faster-whisper
DOUBLETAKE_YTDLP_COOKIES_FROM_BROWSER=     # e.g. chrome — opt-in fallback when anonymous download fails

# --- Instagram (official "Instagram API with Instagram Login") --------------
IG_APP_ID=
IG_APP_SECRET=
IG_WEBHOOK_VERIFY_TOKEN=                   # random string you also paste into the Meta dashboard

# --- notifications --------------------------------------------------------
VAPID_PUBLIC_KEY=                          # optional: leave empty and the server generates + stores a pair on first boot
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com        # contact for push services; default mailto:doubletake@localhost
FCM_SERVICE_ACCOUNT_PATH=                  # Firebase service-account JSON (Android app push); empty = Web Push only

# --- cost ----------------------------------------------------------------
DOUBLETAKE_DAILY_CAP_USD=5
