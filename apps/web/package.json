{
  "name": "@doubletake/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Doubletake PWA (Vite + React)",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
